# Phase 2 — custom domain (build-time, Vite PUBLIC_*)
# PUBLIC_HEALTH_RP_ID=health.bookphysio.in
# PUBLIC_HEALTH_ORIGIN=https://health.bookphysio.in

# Phase 3 — cloud passkey API (Vercel deployment)
# PUBLIC_HEALTH_API_URL=https://your-health-api.vercel.app

# Vercel / API runtime (server only — never expose service role to client)
# HEALTH_RP_ID=health.bookphysio.in
# HEALTH_ORIGIN=https://health.bookphysio.in
# HEALTH_RP_NAME=Health
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: client anon key for future direct Supabase reads (not required for passkey API)
# PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=your-anon-key
